# Optional. Empty (or no .env at all) means same-origin: the control plane
# serves the built console, and `npm run dev` proxies API paths to
# http://localhost:8000 (override the dev target with RBE_DEV_API).
# Set this only to point the UI at a different backend.
VITE_API_BASE_URL=

# Bearer token for specialist endpoints (/review/*, /audit/*). Never commit
# the real value. Leave blank in this file: developers copy it to a local
# .env (git-ignored). Stand-in for the Phase 4 SSO / JWT flow.
VITE_REVIEWER_TOKEN=
