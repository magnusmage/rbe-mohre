# Copy to /etc/rbe/rbe.env on the server (root:rbe, mode 640). Never commit
# the filled file. Generate each token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENV=production
DATABASE_PATH=/var/lib/rbe/rbe.db
AGENT_TOOL_TOKEN=
REVIEWER_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
